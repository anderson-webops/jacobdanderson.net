map "$request_method:$uri" $jacobdanderson_music_allowed {
	default 0;
	~^(GET|HEAD): 1;
	POST:/api/admin/music 1;
}

server {
	listen 80;
	listen [::]:80;
	server_name music.jacobdanderson.net;
	server_tokens off;
	location ^~ /.well-known/acme-challenge/ {
		root /var/www/acme;
		try_files $uri =404;
	}
	location / { return 301 https://music.jacobdanderson.net$request_uri; }
}

server {
	listen 443 ssl;
	listen [::]:443 ssl;
	http2 on;
	server_name music.jacobdanderson.net;
	server_tokens off;

	# ssl_certificate /etc/letsencrypt/live/music.jacobdanderson.net/fullchain.pem;
	# ssl_certificate_key /etc/letsencrypt/live/music.jacobdanderson.net/privkey.pem;

	root /srv/jacobdanderson.net/current/front-end/dist;
	if ($jacobdanderson_music_allowed = 0) { return 405; }

	add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors https://jacobdanderson.net; form-action 'none'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; script-src-attr 'none'; connect-src 'self'; frame-src https://w.soundcloud.com; media-src 'self'; worker-src 'none'; manifest-src 'none'; upgrade-insecure-requests" always;
	add_header Cross-Origin-Opener-Policy "same-origin" always;
	add_header Cross-Origin-Resource-Policy "same-origin" always;
	add_header Permissions-Policy 'accelerometer=(), autoplay=(self "https://w.soundcloud.com"), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()' always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
	add_header X-Content-Type-Options "nosniff" always;

	location = / {
		expires -1;
		try_files /.gallery-sites/music/index.html =404;
	}
	location = /admin/ { return 308 /admin; }
	location = /admin {
		add_header Cache-Control "no-store" always;
		add_header X-Frame-Options DENY always;
		add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; form-action 'none'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; media-src 'self'; frame-src https://w.soundcloud.com" always;
		try_files /.gallery-sites/music/admin/index.html =404;
	}
	location @music_denied { return 403; }
	location ~ ^/api/admin/(access|music)$ {
		auth_basic "Project administration";
		auth_basic_user_file /etc/nginx/jacobdanderson-admin.htpasswd;
		auth_delay 750ms;
		error_page 401 = @music_denied;
		client_max_body_size 48m;
		limit_conn jacobdanderson_per_ip 2;
		limit_req zone=jacobdanderson_admin burst=3 nodelay;
		proxy_set_header Authorization "";
		proxy_set_header Cookie "";
		proxy_set_header Host $host;
		proxy_set_header X-Portfolio-Admin-Actor $remote_user;
		proxy_set_header X-Portfolio-Request-Id $request_id;
		include /etc/nginx/snippets/jacobdanderson-admin-secret.conf;
		proxy_pass http://jacobdanderson_api;
	}
	location = /robots.txt { default_type text/plain; try_files /.gallery-sites/music/robots.txt =404; }
	location = /sitemap.xml { default_type application/xml; try_files /.gallery-sites/music/sitemap.xml =404; }
	location = /images/music-sleeve.svg { try_files $uri =404; }
	location = /favicon.ico { try_files $uri =404; }
	location /favicons/ { try_files $uri =404; }
	location /fonts/ { try_files $uri =404; }
	location /assets/ { expires 1y; try_files $uri =404; }
	location ~ (^|/)\. { return 404; }
	include /etc/nginx/snippets/jacobdanderson-music.locations.conf;
	location / { return 404; }
}
