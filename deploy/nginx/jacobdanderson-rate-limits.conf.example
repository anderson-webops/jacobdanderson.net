# Install this file once in the Nginx http context, outside every server block.
# The small shared-memory zones bound unauthenticated API and Basic-auth work
# without creating per-client state inside the Node process.
limit_conn_zone $binary_remote_addr zone=jacobdanderson_per_ip:1m;
limit_req_zone $binary_remote_addr zone=jacobdanderson_public:1m rate=10r/s;
limit_req_zone $binary_remote_addr zone=jacobdanderson_admin:1m rate=2r/s;
