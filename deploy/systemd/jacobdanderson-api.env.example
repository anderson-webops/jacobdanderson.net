# Install as /etc/jacobdanderson/api.env with mode 0600.
# The systemd unit fixes NODE_ENV, HOST, PORT, ALLOW_PUBLIC_LISTENER,
# TRUST_PROXY_IPS, and the measured Node heap ceiling.

# Choose exactly one database-secret path.
MONGODB_URI=
VAULT_ADDR=http://127.0.0.1:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Internal diagnostics remain disabled during normal operation.
ENABLE_INTERNAL_DIAGNOSTICS=false
INTERNAL_DIAGNOSTICS_KEY=

# Project-card visibility administration is disabled until both the Nginx
# browser gate and trusted proxy key are installed. The key must use 32 to 512
# base64url characters and must match the host-only Nginx secret snippet.
ENABLE_PROJECT_ADMIN=false
PROJECT_ADMIN_PROXY_KEY=
