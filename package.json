{
	"name": "jacobdanderson-monorepo",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.18.1 <25",
		"npm": ">=12.0.2 <13"
	},
	"description": "Monorepo for main page",
	"author": "Jacob Anderson",
	"license": "ISC",
	"keywords": [],
	"workspaces": [
		"front-end",
		"back-end"
	],
	"allowScripts": {
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true,
		"puppeteer@25.4.0": true,
		"simple-git-hooks@2.13.1": true,
		"unrs-resolver@1.12.2": true
	},
	"scripts": {
		"build": "npm run -w front-end build && npm run write:deployment-metadata && npm run verify:static && npm run -w back-end build",
		"dev": "npm run -w front-end dev",
		"server": "npm run -w back-end server",
		"server:once": "npm run -w back-end server:once",
		"serve": "npm run -w front-end serve",
		"test": "npm run -w front-end test:unit -- --run && npm run -w back-end test",
		"verify:static": "node scripts/check-static-output.mjs",
		"verify:native-lock": "node scripts/verify-native-lock.mjs",
		"verify:platform-install": "node scripts/verify-platform-install.mjs",
		"write:deployment-metadata": "node scripts/write-deployment-metadata.mjs",
		"smoke:backend-runtime": "node scripts/backend-runtime-smoke.mjs",
		"smoke:live": "node scripts/live-site-smoke.mjs",
		"postinstall": "simple-git-hooks",
		"lint-server": "npm run -w back-end lint-fix && npm run -w back-end server",
		"lint-serve": "npm run -w front-end lint-fix && npm run -w front-end serve",
		"lint": "npm run lint:root && npm run -w front-end lint && npm run -w back-end lint",
		"lint:root": "eslint \"scripts/**/*.{js,mjs,ts}\" eslint.config.js",
		"lint-fix": "npm run lint:root -- --fix && npm run -w front-end lint-fix && npm run -w back-end lint-fix",
		"typecheck": "npm run -w front-end typecheck && npm run -w back-end typecheck",
		"clean": "node scripts/clean.mjs",
		"up": "taze major -I && npm run -w front-end up && npm run -w back-end up",
		"a11y": "node scripts/a11y-smoke.mjs"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.2.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@unocss/eslint-plugin": "^66.7.5",
		"axe-core": "^4.12.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-vue": "^10.9.0",
		"globals": "^17.8.0",
		"js-beautify": "2.0.3",
		"lint-staged": "^17.2.0",
		"prettier": "^3.9.6",
		"puppeteer": "^25.4.0",
		"simple-git-hooks": "^2.13.1",
		"taze": "^19.16.0",
		"typescript": "^6.0.3"
	},
	"simple-git-hooks": {
		"pre-commit": "test -x ./node_modules/.bin/lint-staged || { echo 'lint-staged is not installed. Run npm install.'; exit 1; }; ./node_modules/.bin/lint-staged"
	},
	"lint-staged": {
		"back-end/**/*.{js,ts}": "npm exec --workspace back-end -- eslint --fix",
		"front-end/**/*.{js,ts,vue}": "npm exec --workspace front-end -- eslint --fix",
		"{eslint.config.js,scripts/*.{js,mjs,ts}}": "eslint --fix"
	},
	"overrides": {
		"defu": "6.1.6",
		"picomatch@^4": "4.0.4",
		"anymatch@3.1.3": {
			"picomatch": "2.3.2"
		},
		"micromatch@4.0.8": {
			"picomatch": "2.3.2"
		},
		"readdirp@3.6.0": {
			"picomatch": "2.3.2"
		},
		"vite": "^8.2.0",
		"vue-router": "^5.0.4",
		"follow-redirects": "1.16.0",
		"brace-expansion": "5.0.8",
		"fast-uri": "3.1.4",
		"js-yaml": "4.3.0",
		"postcss": "8.5.24",
		"shell-quote": "1.10.0",
		"svgo": "4.0.2",
		"tar": "7.5.22",
		"valibot": "1.4.2",
		"js-beautify": "2.0.3"
	}
}
