{
	"name": "back-end",
	"version": "1.0.0",
	"private": true,
	"packageManager": "npm@12.2.2",
	"engines": {
		"node": ">=26.13.1 <27",
		"npm": ">=12.2.2 <13"
	},
	"allowScripts": {
		"esbuild@0.28.2": false,
		"fsevents@2.3.3": false,
		"mongodb": false
	},
	"description": "",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch -r dotenv/config src/server.ts",
		"server:once": "tsx -r dotenv/config src/server.ts",
		"test": "node --test --import tsx test/*.test.ts",
		"start": "node dist/server.js",
		"build": "rm -rf dist && node scripts/run-typescript.mjs -p tsconfig.build.json",
		"typecheck": "node scripts/run-typescript.mjs -p tsconfig.json --noEmit",
		"watch": "node scripts/run-typescript.mjs -w",
		"dev": "tsx watch -r dotenv/config src/server.ts",
		"up": "taze major -I",
		"lint": "eslint \"{src,test}/**/*.{js,ts}\"",
		"lint-fix": "eslint \"{src,test}/**/*.{js,ts}\" --fix"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"dotenv": "^18.0.10",
		"express": "^5.3.0",
		"helmet": "^8.3.0",
		"mongodb": "^7.9.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.11",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-native": "npm:typescript@^7.0.2",
		"typescript-eslint": "^8.74.0"
	},
	"overrides": {
		"minimatch": "11.0.9"
	}
}
