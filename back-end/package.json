{
	"name": "back-end",
	"version": "1.0.0",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.18.1 <25",
		"npm": ">=12.0.2 <13"
	},
	"description": "",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch -r dotenv/config src/server.ts",
		"server:once": "tsx -r dotenv/config src/server.ts",
		"test": "node --test --import tsx test/*.test.ts",
		"start": "node dist/server.js",
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"watch": "tsc -w",
		"dev": "tsx watch -r dotenv/config src/server.ts",
		"up": "taze major -I",
		"lint": "eslint \"{src,test}/**/*.{js,ts}\"",
		"lint-fix": "eslint \"{src,test}/**/*.{js,ts}\" --fix"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.1",
		"helmet": "^8.3.0",
		"mongoose": "^9.9.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^24.13.3",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0"
	}
}
