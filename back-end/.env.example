NODE_ENV=production
HOST=127.0.0.1
PORT=3003
TRUST_PROXY_IPS=loopback

# Choose exactly one database-secret path.
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
VAULT_ADDR=http://127.0.0.1:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Disabled by default. If enabled, use a unique value of at least 32 characters.
ENABLE_INTERNAL_DIAGNOSTICS=false
INTERNAL_DIAGNOSTICS_KEY=
